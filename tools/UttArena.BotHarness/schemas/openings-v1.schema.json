{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uttarena.local/schemas/openings-v1.schema.json",
  "title": "UTT Arena Standard Opening Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "rules", "openings"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "uttarena.openings"
    },
    "version": {
      "const": 1
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "variant", "actionEncoding"],
      "properties": {
        "id": {
          "const": "ultimate-tic-tac-toe"
        },
        "version": {
          "const": 1
        },
        "variant": {
          "const": "standard"
        },
        "actionEncoding": {
          "const": "board*9+cell"
        }
      }
    },
    "openings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "moves"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            }
          }
        }
      }
    }
  }
}
