<?xml version="1.0" encoding="utf-8"?>
<!--
  The arena builds submissions with no network and a single offline feed, so this
  project restores the same way. If a package resolves for you but is not in the
  arena's feed, the build will fail after upload rather than here.

  Run scripts/pack-bot-sdk (ps1 or sh) to populate ../../.packages.

  Clearing packageSourceMapping matters: a machine-wide mapping that routes every
  package pattern to nuget.org would otherwise exclude the offline feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="uttarena-offline" value="../../.packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
